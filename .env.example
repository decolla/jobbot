# Copie para .env (fora do git). Tudo aqui é opcional e fica desligado por padrão.
# Nunca coloque aqui a senha de portais de vagas: o login neles é feito à mão no navegador.

# Leitura de e-mail (acompanhamento e alertas de vagas). Use uma senha de app do seu provedor.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=

# Envio de e-mail (notificações e respostas logísticas)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=

# Telegram (notificações)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
